# ============================================
# CarLink — production settings (docker-compose.prod.yml)
#
# Never put a comment on the same line as a value: compose would read the
# comment as the value.
#
# On the server:
#   cp .env.prod.example .env.prod
#   sh scripts/prod-secrets.sh .env.prod     # fills every secret, prints none
#   nano .env.prod                           # fill every value under a "# FILL" line
#   chmod 600 .env.prod
#
# NEVER commit .env.prod. Keep a copy of PHONE_ENCRYPTION_KEY in your password
# manager: without it the stored phone numbers cannot be read back.
# Full reference of every variable: docs/deployment.md §2–3.
# ============================================

# --- Release ---
# Version published by the Release workflow (tag v1.0.0 -> 1.0.0).
# FILL: e.g. 1.0.0
CARLINK_VERSION=

# --- Domain and HTTPS (Caddy) ---
# FILL: e.g. carlink.com (DNS A record -> this server)
CARLINK_DOMAIN=
# FILL: your e-mail, for certificate notices
ACME_EMAIL=
# Public links in e-mails and QR codes. Derived from the domain; leave as is.
APP_BASE_URL=https://${CARLINK_DOMAIN}
APP_PUBLIC_URL=https://${CARLINK_DOMAIN}

# --- First administrator (first deploy only) ---
# Created at the first start. Sign in, change the password in Settings, then
# delete the ADMIN_BOOTSTRAP_PASSWORD value and restart (up -d --no-build).
# FILL: your admin e-mail
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Secrets (generated by scripts/prod-secrets.sh, never by hand) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
PHONE_ENCRYPTION_KEY=
METRICS_SCRAPE_TOKEN=

# --- E-mail: Brevo SMTP (Brevo -> SMTP & API -> SMTP) ---
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# FILL: Brevo SMTP login
MAIL_USERNAME=
# FILL: Brevo SMTP key
MAIL_PASSWORD=
# Sender shown to users; the domain must be verified in Brevo (SPF + DKIM).
MAIL_FROM=no-reply@${CARLINK_DOMAIN}
MAIL_REPLY_TO=contact@${CARLINK_DOMAIN}
EMAIL_PROVIDER=smtp
# Mailbox receiving the public "Contact us" form.
# FILL: a mailbox you read
CONTACT_TO_EMAIL=

# --- Bot protection: Cloudflare Turnstile (Cloudflare -> Turnstile -> Add site) ---
CAPTCHA_ENABLED=true
# FILL
CAPTCHA_SITE_KEY=
# FILL
CAPTCHA_SECRET_KEY=

# --- SMS to owners ---
# mock = messages are saved and shown in the owner dashboard, no SMS is sent.
# Switch to the real provider once its adapter is merged.
CONTACT_PROVIDER=mock
CONTACT_ENABLED_CHANNELS=SMS

# --- Leave as is ---
POSTGRES_DB=carlink
POSTGRES_USER=carlink
# Caddy already sends HSTS for every response.
HSTS_ENABLED=false
# nginx serves the site and the API from one origin.
CORS_ALLOWED_ORIGINS=
