# ============================================
# CarLink — .gitignore
# ============================================

# Sensitive / local environment files
.env
.env.*
!.env.example

# Java / Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
bin/

# Node / Angular
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.tmp/
*.tgz

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Coverage / reports
coverage/
reports/
*.lcov

# Testcontainers caches
~/.testcontainers.properties
**/.testcontainers/

# Docker
docker-compose.override.yml