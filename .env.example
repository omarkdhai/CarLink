# ============================================
# CarLink environment configuration
# Do not copy by hand: run   node scripts/dev-secrets.mjs
# It creates .env from this file and fills every blank secret below with a
# strong random value (and replaces any value that was ever committed).
# NEVER commit the actual .env file.
# ============================================

# --- Ports ---
FRONTEND_PORT=80
BACKEND_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=carlink
POSTGRES_USER=carlink
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- MailHog ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Application ---
# Base domain used to build public QR URLs
APP_BASE_URL=http://localhost
# Public frontend base URL (used in CORS and QR links)
APP_PUBLIC_URL=http://localhost

# JWT signing secret (required; the app will not start without it)
JWT_SECRET=

# First administrator, created on startup only if no account has this email.
ADMIN_BOOTSTRAP_EMAIL=admin@carlink.local
ADMIN_BOOTSTRAP_PASSWORD=

# Token TTLs
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Conversation expiry (hours)
CONVERSATION_EXPIRY_HOURS=24

# Rate limiting
RATE_LIMIT_IP_PER_MINUTE=5
RATE_LIMIT_QR_PER_HOUR=20
RATE_LIMIT_REPORT_IP_PER_MINUTE=10

# --- Production (docker compose -f docker-compose.prod.yml) ---
# Copy to .env.prod and generate strong random values:
#   openssl rand -hex 48          # for JWT_SECRET
# MAIL_* required for the prod profile's real SMTP sender.
APP_PORT=8080

# TLS edge (Caddy, docker-compose.prod.yml only). Public hostname whose DNS
# points at the server, and the contact address for certificate notices.
CARLINK_DOMAIN=
ACME_EMAIL=

# SMTP transport. Gmail (dev, no branded mailbox yet):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=465
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=<16-char Google App Password, 2FA must be on>
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=false   # port 465 is implicit TLS; set true only on 587
# Once carlink.tn mail exists, swap these to the branded account.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=false

# Envelope sender + Reply-To shown on verification, reset and order emails.
# Gmail rejects a sender the authenticated account does not own. Left empty,
# the prod stack uses MAIL_USERNAME for both.
MAIL_FROM=
MAIL_REPLY_TO=

# Email sender: mock (logs the message) or smtp (real delivery).
# Production must be smtp -- with mock, verification and password-reset mails
# are never delivered. docker-compose.prod.yml already defaults this to smtp.
EMAIL_PROVIDER=mock

# Mailbox that receives the public "Contact us" form.
# Empty: hello@carlink.app.
CONTACT_TO_EMAIL=

# Cross-origin callers allowed to hit the API. Leave empty when nginx serves
# both the SPA and the API from one origin, which is the normal deployment.
CORS_ALLOWED_ORIGINS=

# Send HSTS. Enable only after TLS terminates in front of the backend.
HSTS_ENABLED=false

# --- Bot protection (Cloudflare Turnstile, security plan S-11) ---
# Create a widget at dash.cloudflare.com -> Turnstile; put both keys here.
# Cloudflare test keys for local use: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA (always pass).
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Contact channels ---
# Contact relay provider: mock (default, logs) | telnyx
CONTACT_PROVIDER=mock
# Channels advertised/acceptance. SMS-only is the supported configuration.
CONTACT_ENABLED_CHANNELS=SMS

# --- Telnyx (only used when CONTACT_PROVIDER=telnyx) ---
# API key. Never commit or log this value.
TELNYX_API_KEY=
# SMS-enabled number in E.164, assigned to a messaging profile in the portal.
TELNYX_SMS_FROM=
# Caller ID for the alert call.
TELNYX_VOICE_FROM=
# Call Control connection the outbound call is placed on.
TELNYX_CONNECTION_ID=
# Static audio clip played when the owner answers (public HTTPS URL).
TELNYX_VOICE_AUDIO_URL=
