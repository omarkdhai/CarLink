# ============================================
# CarLink environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ============================================

# --- PostgreSQL ---
POSTGRES_DB=carlink
POSTGRES_USER=carlink
POSTGRES_PASSWORD=change_this_dev_password
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change_this_redis_password
REDIS_PORT=6379

# --- MailHog ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Application ---
# Base domain used to build public QR URLs
APP_BASE_URL=http://localhost:8080
# Public frontend base URL (used in CORS and QR links)
APP_PUBLIC_URL=http://localhost:4200

# JWT secrets - generate strong random values in production
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret_32_chars

# Token TTLs
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Conversation expiry (hours)
CONVERSATION_EXPIRY_HOURS=24

# Rate limiting
RATE_LIMIT_IP_PER_MINUTE=5
RATE_LIMIT_QR_PER_HOUR=20
RATE_LIMIT_REPORT_IP_PER_MINUTE=10

# --- Production (docker compose -f docker-compose.prod.yml) ---
# Copy to .env.prod and generate strong random values:
#   openssl rand -base64 48       # for JWT_SECRET / JWT_REFRESH_SECRET
# MAIL_* required for the prod profile's real SMTP sender.
APP_PORT=8080
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Contact channels ---
# Channel provider: mock (default) | twilio
CONTACT_PROVIDER=mock

# --- Twilio (only used when CONTACT_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
